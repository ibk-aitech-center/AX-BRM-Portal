{
  "name": "ai-brm-request",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AX-BRM 요청 접수 서비스 — 현업 직원 인터뷰 · 요약 · 신청 · BRM 검토 · 통계",
  "scripts": {
    "dev": "node server/scripts/gen-popup.js && concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "flow:export": "node server/scripts/gen-flow-standalone.js",
    "hr:sync": "node server/scripts/hr-sync.js",
    "reset:requests": "node server/scripts/reset-requests.js",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "node tests/e2e.drive.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.0.0",
    "d2coding": "^1.3.2",
    "playwright-core": "^1.50.0",
    "pretendard": "^1.3.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
