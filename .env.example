# ── 서버 ──────────────────────────────────────────────
PORT=3000
# 운영: production (popup 목업·상세 에러 노출 차단)
NODE_ENV=development

# ── SSO (SSO연동가이드 §2·§11) ─────────────────────────
# 포탈 운영팀에서 수령한 sign 문자열. 앞 32자를 base64 디코딩한 24바이트가 HMAC 키.
# 절대 코드·문서에 하드코딩하지 말 것. 아래 값은 로컬 개발용 임의 값이다.
SSO_JWT_SIGN=REPLACE_WITH_PORTAL_SIGN_STRING_AT_LEAST_32_CHARS
SSO_CLOCK_SKEW_SECONDS=60

# 클라이언트 부트스트랩(index.html IIFE)에 주입되는 포탈 팝업 경로 — 포탈에 등록받은 값으로 교체
VITE_SSO_PORTAL_PROD=http://aiportal.ibk.co.kr/portal/link/aibrm/popup
VITE_SSO_PORTAL_DEV=http://devaiportal.ibk.co.kr/portal/link/aibrm/popup

# ── DB ────────────────────────────────────────────────
# 비우면 node:sqlite (의존성 0, 파일 1개). PostgreSQL 사용 시 postgres://user:pw@host:5432/aibrm
# ⚠ 운영(NODE_ENV=production)에서는 DATABASE_URL 이 필수 — 비어 있으면 서버가 기동을 거부한다.
#   (SQLite 로 떨어지면 컨테이너 재배포 때 상담 데이터가 통째로 사라지기 때문)
DATABASE_URL=
SQLITE_PATH=./data/ai-brm.sqlite
# 운영에서 그래도 SQLite 를 쓰려면(SQLITE_PATH 가 PVC 위에 있을 때만) 1 로 명시
DB_ALLOW_SQLITE=

# ── 파일 저장 ─────────────────────────────────────────
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=20

# ── 역할 시드 (콤마 구분 사번). 기동 시 role 부여. 이후에는 관리 화면에서 변경 ──
ADMIN_EMPLOYEE_NOS=

# --- HR 인사 미러 (직책 position 의 원천 — server/hrSync.js) ---
# 미설정 시: 개발은 목업 직원으로 미러를 시드, 운영은 동기화를 건너뜀 (mysql2 설치 필요: npm i mysql2)
HR_DB_HOST=
HR_DB_PORT=3306
HR_DB_USER=
HR_DB_PASSWORD=
HR_DB_NAME=
HR_DB_TABLE=tbl_employee_adv
# 원본의 팀명 컬럼명 (인사 마스터마다 다를 수 있음). 미러에서는 beteam_nm 으로 저장
HR_DB_TEAM_NM_COL=beteam_nm

# --- 사내 메신저 알림 (server/notify.js · AI 포탈 AlarmCall 과 같은 AnnounceService 규약) ---
# 둘 다 채우면 실제 발송, 비우면 로그만 남긴다(개발·검증). 발송 시점: 요청자 신청 확정(→ 관리자 전원만 · AX-BRM 은 안 받음), 담당자 지정(→ 지정된 담당자), 요청자의 문의·대화(→ 지정 담당자 · 미지정이면 안 보냄)
# ALARM_URL 예: http://<메신저 서버>:8010/servlet/AnnounceService  · ALARM_SRV_CODE: 메신저 운영팀에서 AX-BRM 용으로 발급받은 서비스코드
ALARM_URL=
ALARM_SRV_CODE=
ALARM_TIMEOUT_MS=5000
# 알림 안의 링크 기준 주소 (운영 도메인). 비우면 요청 헤더의 호스트를 쓴다
APP_URL=
